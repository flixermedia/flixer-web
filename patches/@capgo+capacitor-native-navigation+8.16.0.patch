+    private void setMusicPlayerSurfaceVisible(boolean visible) {
+        LinearLayout surface = musicPlayerSurface;
+        if (surface == null || (musicPlayerVisibilityAnimationTarget != null && musicPlayerVisibilityAnimationTarget == visible)) {
+            return;
+        }
+
+        boolean wasVisible = surface.getVisibility() == View.VISIBLE;
+        if (musicPlayerVisibilityAnimationTarget == null) {
+            if (visible && wasVisible && surface.getAlpha() >= 0.999f && surface.getTranslationY() == 0f) {
+                return;
+            }
+            if (!visible && !wasVisible) {
+                return;
+            }
+        }
+        musicPlayerVisibilityAnimationTarget = visible;
+        surface.animate().cancel();
+        if (!visible) {
+            if (!wasVisible) {
+                surface.setVisibility(View.GONE);
+                surface.setAlpha(1f);
+                surface.setTranslationY(0f);
+                return;
+            }
+            surface
+                .animate()
+                .alpha(0f)
+                .translationY(dp(12))
+                .setDuration(TabbarChromeSupport.TABBAR_VISIBILITY_ANIMATION_MS)
+                .withEndAction(() -> {
+                    if (musicPlayerSurface == surface && Boolean.FALSE.equals(musicPlayerVisibilityAnimationTarget)) {
+                        surface.setVisibility(View.GONE);
+                        surface.setAlpha(1f);
+                        surface.setTranslationY(0f);
+                        musicPlayerVisibilityAnimationTarget = null;
+                    }
+                })
+                .start();
+            return;
+        }
+
+        if (!wasVisible) {
+            surface.setVisibility(View.VISIBLE);
+            surface.setAlpha(0f);
+            surface.setTranslationY(dp(12));
+        }
+        surface
+            .animate()
+            .alpha(1f)
+            .translationY(0f)
+            .setDuration(TabbarChromeSupport.TABBAR_VISIBILITY_ANIMATION_MS)
+            .withEndAction(() -> {
+                if (musicPlayerSurface == surface && Boolean.TRUE.equals(musicPlayerVisibilityAnimationTarget)) {
+                    musicPlayerVisibilityAnimationTarget = null;
+                }
+            })
+            .start();
+    }
