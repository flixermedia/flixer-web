+    private func setMusicPlayerSurfaceVisible(_ visible: Bool, animated: Bool = true) {
+        guard let surface = musicPlayerSurface else {
+            return
+        }
+        guard musicPlayerVisibilityAnimationTarget != visible else {
+            return
+        }
+        if musicPlayerVisibilityAnimationTarget == nil {
+            if visible, !surface.isHidden, surface.alpha >= 0.999, surface.transform.isIdentity {
+                return
+            }
+            if !visible, surface.isHidden {
+                return
+            }
+        }
+        musicPlayerVisibilityAnimationTarget = visible
+
+        if !animated {
+            surface.layer.removeAllAnimations()
+            surface.isHidden = !visible
+            surface.alpha = visible ? 1 : 0
+            surface.transform = .identity
+            return
+        }
+
+        if visible {
+            let wasHidden = surface.isHidden
+            surface.layer.removeAllAnimations()
+            surface.isHidden = false
+            if wasHidden {
+                surface.alpha = 0
+                surface.transform = CGAffineTransform(translationX: 0, y: 12).scaledBy(x: 0.98, y: 0.98)
+            }
+            UIView.animate(
+                withDuration: 0.22,
+                delay: 0,
+                options: [.beginFromCurrentState, .allowUserInteraction, .curveEaseOut],
+                animations: {
+                    surface.alpha = 1
+                    surface.transform = .identity
+                },
+                completion: { _ in
+                    if self.musicPlayerVisibilityAnimationTarget == true {
+                        self.musicPlayerVisibilityAnimationTarget = nil
+                    }
+                }
+            )
+            return
+        }
+
+        guard !surface.isHidden else {
+            surface.alpha = 0
+            surface.transform = .identity
+            musicPlayerVisibilityAnimationTarget = nil
+            return
+        }
+        surface.layer.removeAllAnimations()
+        UIView.animate(
+            withDuration: 0.22,
+            delay: 0,
+            options: [.beginFromCurrentState, .allowUserInteraction, .curveEaseIn],
+            animations: {
+                surface.alpha = 0
+                surface.transform = CGAffineTransform(translationX: 0, y: 12).scaledBy(x: 0.98, y: 0.98)
+            },
+            completion: { _ in
+                guard self.musicPlayerVisibilityAnimationTarget == false else {
+                    return
+                }
+                surface.isHidden = true
+                surface.transform = .identity
+                self.musicPlayerVisibilityAnimationTarget = nil
+            }
+        )
+    }
