+        int width = tabbarContainer.getWidth() > 0 ? tabbarContainer.getWidth() : tabbarParams.width;
+        int left = tabbarContainer.getWidth() > 0 ? tabbarContainer.getLeft() : tabbarParams.leftMargin;
+        int height = dp(66);
