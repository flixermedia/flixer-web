{
  "singleQuote": false,
  "semi": true,
  "printWidth": 860,
  "tabWidth": 4,
  "useTabs": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": [
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "options": {
        "parser": "jsonc"
      }
    }
  ]
}