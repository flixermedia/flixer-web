{
  "name": "flixer",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "postinstall": "patch-package",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "i18n:check": "node scripts/check-locales.mjs",
    "tunnel": "npx localtunnel --port 5173 --subdomain flixer-dev-zepli --local-https --allow-invalid-cert"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-autofill-save-password": "^8.2.3",
    "@capgo/capacitor-native-audio": "^8.4.38",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@capgo/capacitor-persistent-account": "^8.0.49",
    "@capgo/capacitor-textinteraction": "^8.1.6",
    "@capgo/capacitor-video-player": "^8.2.15",
    "@flixermedia/flixer-api-client": "1.0.1",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify/vue": "^5.0.4",
    "@kolirt/vue-modal": "^2.4.0",
    "@sentry/vue": "^11.8.0",
    "@simplewebauthn/browser": "^14.0.0",
    "axios": "^1.12.2",
    "flag-icons": "^7.6.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  }
}
