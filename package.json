{
  "name": "flixer",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "screenshots": "node --experimental-strip-types scripts/screenshots.mjs",
    "test:screenshots": "node --experimental-strip-types --test scripts/screenshots.test.mjs",
    "test-storybook": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --project=storybook",
    "coverage": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage",
    "postinstall": "patch-package",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "i18n:check": "node --experimental-strip-types scripts/check-locales.ts",
    "storybook": "NODE_OPTIONS=--max-old-space-size=8192 storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS=--max-old-space-size=8192 storybook build",
    "tunnel": "npx localtunnel --port 5173 --subdomain flixer-dev-zepli --local-https --allow-invalid-cert"
  },
  "dependencies": {
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@capgo/capacitor-autofill-save-password": "^8.2.3",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@capgo/capacitor-native-navigation": "^8.16.0",
    "@capgo/capacitor-persistent-account": "^8.0.49",
    "@capgo/capacitor-textinteraction": "^8.1.6",
    "@capgo/capacitor-video-player": "^8.2.15",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify/vue": "^5.0.4",
    "@kolirt/vue-modal": "^2.4.0",
    "@noble/hashes": "^2.3.0",
    "@sentry/vue": "^11.8.0",
    "@simplewebauthn/browser": "^14.0.0",
    "axios": "^1.12.2",
    "dashjs": "^5.2.1",
    "flag-icons": "^7.6.0",
    "flixer-api-client": "1.2.1",
    "hls.js": "^1.7.4",
    "monaco-editor": "^0.57.0",
    "nuxt-charts": "^3.2.0",
    "reka-ui": "^2.11.0",
    "ts-mls": "^1.6.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/tsconfig": "^0.9.1",
    "patch-package": "^8.0.1",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  }
}
